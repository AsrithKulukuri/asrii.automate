# Application Environment Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Session pooler (URL-encode special characters in the password)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?schema=asrii&sslmode=require&connection_limit=2"

# Security & Encryption (32-byte / 64-hex AES-256-GCM secret for token encryption)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta Graph API Integration (Official Instagram Messaging API)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_VERIFY_TOKEN="asrii_automate_verify_token_secret_123"
META_API_VERSION="v21.0"
META_REDIRECT_URI="http://localhost:3000/api/meta/connect"

# Supabase Auth & Cloud Database (Optional for cloud deploy)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
# Local testing: real message dispatch is disabled unless explicitly enabled.
ENABLE_LIVE_META="false"

# Instagram Login (API setup with Instagram login in Meta)
META_LOGIN_PROVIDER="instagram"
