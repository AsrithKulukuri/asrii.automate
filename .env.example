# Application Environment Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (SQLite for local dev, PostgreSQL for Supabase)
DATABASE_URL="file:./dev.db"

# Security & Encryption (32-byte / 64-hex AES-256-GCM secret for token encryption)
TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta Graph API Integration (Official Instagram Messaging API)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_VERIFY_TOKEN="asrii_automate_verify_token_secret_123"
META_API_VERSION="v21.0"
META_REDIRECT_URI="http://localhost:3000/api/meta/connect"

# Supabase Auth & Cloud Database (Optional for cloud deploy)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"